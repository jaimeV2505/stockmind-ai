# Copy to .env (never commit .env). All values are placeholders.
APP_ENV=development

# Market data mode: "demo" (simulated, clearly labelled) or "live" (requires provider credentials)
MARKET_DATA_MODE=demo

# Providers (leave empty until licensed/configured; adapters are NOT implemented yet)
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
FMP_API_KEY=
SEC_EDGAR_USER_AGENT=

# Supabase (server-side only; the service-role key must NEVER reach the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local dev database (docker compose)
DATABASE_URL=postgresql://stockmind:stockmind@localhost:5432/stockmind

# LLM (used for explanations/news only, never for numeric analysis)
ANTHROPIC_API_KEY=

# --- Web app (apps/web) -------------------------------------------------------------------------------------------------
# Which snapshot the site serves: "demo" (simulated, default) or "market" (real end-of-day data from Alpaca).
STOCKMIND_DATA=demo
# HTTP Basic protection. MANDATORY (>= 12 chars) when STOCKMIND_DATA=market: the site returns 503 without it. Set in Vercel, never commit.
SITE_USER=stockmind
SITE_PASSWORD=
